{
  "name": "nextapp2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "collect:openrouter": "tsx src/lib/collectors/cli.ts --collector=openrouter",
    "collect:openrouter:dry": "tsx src/lib/collectors/cli.ts --collector=openrouter --dry-run",
    "collect:gemini": "tsx src/lib/collectors/cli.ts --collector=gemini",
    "collect:gemini:dry": "tsx src/lib/collectors/cli.ts --collector=gemini --dry-run",
    "collect:groq": "tsx src/lib/collectors/cli.ts --collector=groq",
    "collect:groq:dry": "tsx src/lib/collectors/cli.ts --collector=groq --dry-run",
    "collect:all": "tsx scripts/collect-all.ts",
    "smoke:deploy": "tsx scripts/deploy-smoke.ts"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
